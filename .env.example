# Copy this file to .env and fill in values locally. Never commit .env.
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
TIGER_DATABASE_URL=

# Shared only by the downloadable helper and Vercel's server environment.
# Generate a long random value, then add the same value to Vercel.
PORT_A_POTTY_AGENT_KEY=

# Used by Port-a-Potty-Helper.exe. Set this to your Vercel deployment URL.
PORT_A_POTTY_API_URL=
PORT_A_POTTY_DEVICE_ID=
PORT_A_POTTY_HELPER_INTERVAL_SECONDS=60
# Optional deployment URL used when generating downloadable helper packages.
PORT_A_POTTY_PUBLIC_URL=https://hackumbc-portapotty.vercel.app
# Optional: Vercel Deployment Protection bypass secret for a protected project.
PORT_A_POTTY_VERCEL_BYPASS_SECRET=

# Static demo source: combined_attack, brute_force, password_spray, normal_activity
PORT_A_POTTY_LOG_SCENARIO=combined_attack

